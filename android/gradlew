#!/bin/sh

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -x "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" ]; then
  :
fi

if command -v java >/dev/null 2>&1; then
  exec java ${JAVA_OPTS:-} -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
fi

echo "Java is required to run the Gradle wrapper. Install JDK 17 or newer." >&2
exit 1